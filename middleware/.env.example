# Copy this file to .env and fill in your values.
# Used both for local `uvicorn` runs (via python-dotenv) and by docker-compose.yml
# (docker compose auto-loads .env from this directory for variable substitution).

# Hostname or IP of your OPNsense box, no scheme (e.g. 192.168.1.1 or opnsense.localdomain)
OPNSENSE_HOST=

# Create a scoped, read-only API key/secret pair in OPNsense under
# System > Access > Users -- see README.md in this directory for steps.
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# Set to false only if OPNsense is using a self-signed cert you haven't trusted
# on this host. Prefer trusting the cert over disabling verification.
VERIFY_SSL=true

# Poll cadence in seconds.
POLL_INTERVAL_FAST=2.0
POLL_INTERVAL_SLOW=15.0

# Host-side port for docker-compose.yml (container always listens on 8000
# internally). Default avoids Portainer's common 8000 edge-agent port.
MIDDLEWARE_PORT=8098
